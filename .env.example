# Copy to .env for local Docker Compose development. Do not commit real credentials.
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

POSTGRES_DB=grievx
POSTGRES_USER=grievx
POSTGRES_PASSWORD=change-me-for-local-development
DATABASE_URL=postgresql+asyncpg://grievx:change-me-for-local-development@postgres:5432/grievx

REDIS_URL=redis://redis:6379/0

MINIO_ROOT_USER=grievx-minio
MINIO_ROOT_PASSWORD=change-me-minio-password
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=grievx-minio
S3_SECRET_ACCESS_KEY=change-me-minio-password
S3_BUCKET=grievx-uploads
S3_REGION=us-east-1
